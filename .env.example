# =============================================================================
# BioArchitect — Environment variables (template)
# Скопируй этот файл в .env и заполни значениями. .env НИКОГДА не коммитится.
# В продакшне используем sops + age, см. docs/architecture-decisions/0003-secrets-management.md
# =============================================================================

# --- Окружение ---
ENV=local                       # local | staging | production
DEBUG=true
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
TZ=Europe/Berlin

# --- Telegram ---
TELEGRAM_BOT_TOKEN=             # из @BotFather
TELEGRAM_BOT_USERNAME=          # без @
TELEGRAM_WEBHOOK_URL=           # пусто = polling, иначе https://...
TELEGRAM_WEBHOOK_SECRET=

# --- Anthropic (единственный LLM-провайдер) ---
ANTHROPIC_API_KEY=
# Используем 2 модели:
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_PROMPT_CACHE=true     # cache_control: ephemeral на системные промпты

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bioarchitect
POSTGRES_USER=bioarchitect
POSTGRES_PASSWORD=change_me_locally
DATABASE_URL=postgresql+asyncpg://bioarchitect:change_me_locally@postgres:5432/bioarchitect

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- Платежи (заполняем по мере подключения) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PROPLUS_MONTHLY=
STRIPE_PRICE_PROPLUS_ANNUAL=
TELEGRAM_STARS_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Хранилище (фото бланков анализов) ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=bioarchitect-lab-reports-eu
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
LAB_REPORTS_ENCRYPTION_KEY=     # AES-256, base64-encoded; генерируется один раз

# --- Sentry / observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
PROMETHEUS_PORT=9090

# --- Лимиты и фичи ---
RATE_LIMIT_FREE_LLM_PER_DAY=5
RATE_LIMIT_PRO_LLM_PER_DAY=50
RATE_LIMIT_PROPLUS_LLM_PER_DAY=150
RATE_LIMIT_FREE_VISION_PER_DAY=1
RATE_LIMIT_PRO_VISION_PER_DAY=15
RATE_LIMIT_PROPLUS_VISION_PER_DAY=30
RATE_LIMIT_PRO_OCR_PER_MONTH=5
RATE_LIMIT_PROPLUS_OCR_PER_MONTH=20

# --- GDPR / правовые ---
GDPR_DELETION_GRACE_DAYS=30
EU_DATA_RESIDENCY_REQUIRED=true
DPA_SIGNED_ANTHROPIC=false      # установить в true только после подписания
MEDICAL_ADVISOR_NAME=           # ФИО, требуется для verified_by в lab_reference_ranges
MEDICAL_ADVISOR_LICENSE=

# --- Локализация ---
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en,pl,de

# --- Censor Agent ---
CENSOR_ENABLED=true             # ВНИМАНИЕ: false запрещено в продакшне (CI проверяет)
CENSOR_LOG_BLOCKED=true

# --- Mini App ---
MINIAPP_URL=https://localhost:5173
MINIAPP_VALIDATE_INIT_DATA=true
